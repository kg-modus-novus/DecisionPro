            "text": "<footer class=\"usa-footer usa-footer--big\">\n        <div style=\"background-color: #0d4f9e; color: #fff; padding: 1.5rem 0;\">\n            <div class=\"grid-container\">\n                <div class=\"grid-row\">\n                    <div class=\"grid-col-12\">\n                        <p style=\"font-weight: 700; font-size: 1rem; border-bottom: 1px solid rgba(255,255,255,0.4); padding-bottom: 0.5rem; margin-bottom: 1rem;\">Quick Links</p>\n                    </div>\n                </div>\n                <div class=\"grid-row grid-gap\">\n                    <div class=\"tablet:grid-col-3\"><a href=\"/about-the-agency-for-health-care-administration.html\" style=\"color: #fff; text-decoration: none;\">About the Agency</a></div>\n                    <div class=\"tablet:grid-col-3\"><a href=\"/provider/\" style=\"color: #fff; text-decoration: none;\">Provider Enrollment</a></div>\n                    <div class=\"tablet:grid-col-3\"><a href=\"/agency-administration/chief-of-staff-office/office-of-communications.html\" style=\"color: #fff; text-decoration: none;\">Latest News</a></div>\n                    <div class=\"tablet:grid-col-3\"><a href=\"https://apps.ahca.myflorida.com/public-meetings/\" style=\"color: #fff; text-decoration: none;\">Public Meetings</a></div>\n                </div>\n                <div class=\"grid-row grid-gap margin-top-1\">\n                    <div class=\"tablet:grid-col-3\"><a href=\"https://quality.healthfinder.fl.gov/\" style=\"color: #fff; text-decoration: none;\">Find a Facility</a></div>\n                    <div class=\"tablet:grid-col-3\"><a href=\"/health-quality-assurance/bureau-of-central-services/background-screening.html\" style=\"color: #fff; text-decoration: none;\">Background Screening</a></div>\n                    <div class=\"tablet:grid-col-3\"><a href=\"/agency-administration/chief-of-staff-office/office-of-communications/public-records.html\" style=\"color: #fff; text-decoration: none;\">Public Records</a></div>\n                    <div class=\"tablet:grid-col-3\"><a href=\"/contact-ahca.html\" style=\"color: #fff; text-decoration: none;\">Contact Us</a></div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"usa-footer__primary-section\" style=\"background-color: #112549;\">\n            <div class=\"grid-container\" style=\"padding-top: 1.5rem; padding-bottom: calc(1.5rem + 60px);\">\n                <div class=\"grid-row\" style=\"align-items: center;\">\n\n                    <!-- Left: Seal + text -->\n                    <div class=\"tablet:grid-col-7\" style=\"display: flex; align-items: center; gap: 1.25rem;\">\n                        <a href=\"/\">\n                            <img src=\"/assets/build/images/Seal_of_Florida2_654cc5fb06.svg\" alt=\"Seal of Florida\" style=\"width: 90px; height: 90px; flex-shrink: 0;\">\n                        </a>\n                        <div style=\"color: #fff; font-size: 0.875rem; line-height: 1.6;\">\n                            <p style=\"margin: 0 0 0.2rem;\">Official website of the State of Florida</p>\n                            <p style=\"margin: 0 0 0.2rem;\">\n                                <a href=\"/accessibility.html\" style=\"color: #fff; text-decoration: underline;\">Accessibility</a>\n                                &nbsp;|&nbsp;\n                                <a href=\"/disclaimer.html\" style=\"color: #fff; text-decoration: underline;\">Disclaimer</a>\n                            </p>\n                            <p style=\"margin: 0;\">2727 Mahan Drive, Tallahassee, FL 32308</p>\n                        </div>\n                    </div>\n\n                    <!-- Right: Social icons + Join Team AHCA + copyright -->\n                    <div class=\"tablet:grid-col-5\" style=\"color: #fff; text-align: right;\">\n                        <div style=\"display: flex; justify-content: flex-end; align-items: center; gap: 6px; margin-bottom: 0.65rem;\">