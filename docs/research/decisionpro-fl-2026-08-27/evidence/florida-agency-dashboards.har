            "mimeType": "application/javascript",
            "text": "// Client-side search script for the static mirror.\r\n// Loaded on every page; activates search via a pre-built Lunr.js index.\r\n(function () {\r\n  'use strict';\r\n\r\n  var INDEX_PATH = '_search/search-index.json';\r\n  var DOCS_PATH = '_search/search-docs.json';\r\n\r\n  var searchIndex = null;\r\n  var searchDocs = null;\r\n\r\n  // ── Utility ─────────────────────────────────────────────────\r\n\r\n  function getBasePath() {\r\n    var path = window.location.pathname;\r\n    var depth = (path.match(/\\//g) || []).length - 1;\r\n    if (depth <= 0) return './';\r\n    return '../'.repeat(depth);\r\n  }\r\n\r\n  function getQueryParam(name) {\r\n    // Check URL search params first\r\n    var params = new URLSearchParams(window.location.search);\r\n    var val = params.get(name);\r\n    if (val) return val;\r\n    // Fallback: hash fragment (survives server redirects that strip query params)\r\n    if (window.location.hash && window.location.hash.length > 1) {\r\n      try {\r\n        var hashParams = new URLSearchParams(window.location.hash.slice(1));\r\n        return hashParams.get(name) || '';\r\n      } catch (e) { return ''; }\r\n    }\r\n    return '';\r\n  }\r\n\r\n  function escapeHtml(str) {\r\n    var div = document.createElement('div');\r\n    div.textContent = str;\r\n    return div.innerHTML;\r\n  }\r\n\r\n  function highlightTerms(text, terms) {\r\n    if (!terms || terms.length === 0) return escapeHtml(text);\r\n    var escaped = escapeHtml(text);\r\n    terms.forEach(function (term) {\r\n      var re = new RegExp('(' + term.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + ')', 'gi');\r\n      escaped = escaped.replace(re, '<b>$1</b>');\r\n    });\r\n    return escaped;\r\n  }\r\n\r\n  function getSnippet(body, terms, maxLen) {\r\n    maxLen = maxLen || 200;\r\n    if (!terms || terms.length === 0) return escapeHtml(body.slice(0, maxLen)) + '...';\r\n    var lower = body.toLowerCase();\r\n    var bestPos = -1;\r\n    for (var i = 0; i < terms.length; i++) {\r\n      var pos = lower.indexOf(terms[i].toLowerCase());\r\n      if (pos !== -1) { bestPos = pos; break; }\r\n    }\r\n    var start = Math.max(0, bestPos - 60);\r\n    var snippet = body.slice(start, start + maxLen);\r\n    if (start > 0) snippet = '...' + snippet;\r\n    if (start + maxLen < body.length) snippet += '...';\r\n    return highlightTerms(snippet, terms);\r\n  }\r\n\r\n  // ── Loading ─────────────────────────────────────────────────\r\n\r\n  function loadJSON(url, callback) {\r\n    var xhr = new XMLHttpRequest();\r\n    xhr.open('GET', url, true);\r\n    xhr.onreadystatechange = function () {\r\n      if (xhr.readyState === 4 && xhr.status === 200) {\r\n        callback(JSON.parse(xhr.responseText));\r\n      }\r\n    };\r\n    xhr.send();\r\n  }\r\n\r\n  function loadIndex(basePath, callback) {\r\n    if (searchIndex && searchDocs) { callback(); return; }\r\n    var loaded = 0;\r\n    loadJSON(basePath + INDEX_PATH, function (data) {\r\n      searchIndex = lunr.Index.load(data);\r\n      if (++loaded === 2) callback();\r\n    });\r\n    loadJSON(basePath + DOCS_PATH, function (data) {\r\n      searchDocs = {};\r\n      data.forEach(function (doc) { searchDocs[doc.id] = doc; });\r\n      if (++loaded === 2) callback();\r\n    });\r\n  }\r\n\r\n  // ── Rendering ───────────────────────────────────────────────\r\n\r\n  function renderResults(results, query) {\r\n    var terms = query.trim().split(/\\s+/);\r\n    var container = document.getElementById('search-results');\r\n    if (!container) return;\r\n\r\n    if (results.length === 0) {\r\n      container.innerHTML = '<p class=\"search-no-results\">No results found for \"<strong>' + escapeHtml(query) + '</strong>\".</p>';\r\n      return;\r\n    }\r\n\r\n    var basePath = getBasePath();\r\n    var html = '<p class=\"search-result-count\">' + results.length + ' result' + (results.length !== 1 ? 's' : '') + ' for \"<strong>' + escapeHtml(query) + '</strong>\"</p>';\r\n\r\n    results.forEach(function (result) {\r\n      var doc = searchDocs[result.ref];\r\n      if (!doc) return;\r\n      var snippet = getSnippet(doc.body || '', terms);\r\n      var href = basePath + doc.url;\r\n      html += '<article class=\"media search-result\">' +\r\n        '<div class=\"media-content\"><div class=\"content\"><p>' +\r\n        '<a class=\"search-result__title\" href=\"' + escapeHtml(href) + '\"><strong>' + highlightTerms(doc.title, terms) + '</strong></a><br>' +\r\n        snippet +\r\n        '</p></div>' +\r\n        '<nav class=\"level is-mobile\"><div class=\"level-left\"><p><a href=\"' + escapeHtml(href) + '\">' + escapeHtml(doc.url) + '</a></p></div></nav>' +\r\n        '</div></article>';\r\n    });\r\n\r\n    container.innerHTML = html;\r\n  }\r\n\r\n  function performSearch(query) {\r\n    if (!query || !searchIndex) return;\r\n    var results = searchIndex.search(query);\r\n    renderResults(results, query);\r\n  }\r\n\r\n  // ── Neutralize original site search JS ──────────────────────\r\n\r\n  function neutralizeOriginalSearch() {\r\n    // Clone form + result containers to strip all jQuery event handlers\r\n    // that the original Kotx module attached. Cloning breaks jQuery's\r\n    // cached element references so AJAX callbacks write to detached nodes.\r\n    var ids = ['search-main-form', 'search-results', 'search-facets'];\r\n    ids.forEach(function (id) {\r\n      var el = document.getElementById(id);\r\n      if (el) {\r\n        var clone = el.cloneNode(true);\r\n        el.parentNode.replaceChild(clone, el);\r\n      }\r\n    });\r\n  }\r\n\r\n  // ── Init on search page ─────────────────────────────────────\r\n\r\n  function initSearchPage() {\r\n    var basePath = getBasePath();\r\n\r\n    // Strip old event handlers first\r\n    neutralizeOriginalSearch();\r\n\r\n    // Re-query the (now-clean) elements\r\n    var form = document.getElementById('search-main-form');\r\n    var input = document.getElementById('search-keyword');\r\n    var loading = form ? form.querySelector('.is-loading') : null;\r\n\r\n    // Pre-fill from URL param (or hash fallback)\r\n    var q = getQueryParam('q');\r\n    if (input && q) input.value = q;\r\n    if (loading) loading.style.display = 'none';\r\n\r\n    // Attach our own submit handler\r\n    if (form) {\r\n      form.setAttribute('action', '');\r\n      form.addEventListener('submit', function (e) {\r\n        e.preventDefault();\r\n        e.stopImmediatePropagation();\r\n        var query = input ? input.value.trim() : '';\r\n        if (!query) return;\r\n        var url = window.location.pathname + '?q=' + encodeURIComponent(query);\r\n        window.history.pushState({}, '', url);\r\n        if (loading) loading.style.display = 'inline-block';\r\n        loadIndex(basePath, function () {\r\n          if (loading) loading.style.display = 'none';\r\n          performSearch(query);\r\n        });\r\n      });\r\n    }\r\n\r\n    // Auto-search if query is present\r\n    if (q) {\r\n      if (loading) loading.style.display = 'inline-block';\r\n      loadIndex(basePath, function () {\r\n        if (loading) loading.style.display = 'none';\r\n        performSearch(q);\r\n      });\r\n    }\r\n\r\n    // Handle back/forward\r\n    window.addEventListener('popstate', function () {\r\n      var query = getQueryParam('q');\r\n      if (input) input.value = query;\r\n      if (query && searchIndex) performSearch(query);\r\n    });\r\n  }\r\n\r\n  // ── Init header search forms ────────────────────────────────\r\n\r\n  function initHeaderSearch() {\r\n    var basePath = getBasePath();\r\n    var forms = document.querySelectorAll('form.usa-search');\r\n    forms.forEach(function (form) {\r\n      form.addEventListener('submit', function (e) {\r\n        e.preventDefault();\r\n        e.stopImmediatePropagation();\r\n        var input = form.querySelector('input[name=\"q\"]');\r\n        var query = input ? input.value.trim() : '';\r\n        if (!query) return;\r\n        // Use the form action (correct relative path) with both query param\r\n        // and hash fallback (hash survives server clean-URL redirects)\r\n        var action = form.getAttribute('action') || 'search.html';\r\n        var searchUrl = action + '?q=' + encodeURIComponent(query) +\r\n                        '#q=' + encodeURIComponent(query);\r\n        window.location.href = searchUrl;\r\n      });\r\n    });\r\n  }\r\n\r\n  // ── Bootstrap ───────────────────────────────────────────────\r\n\r\n  function init() {\r\n    initHeaderSearch();\r\n    if (document.getElementById('search-main-form')) {\r\n      initSearchPage();\r\n    }\r\n  }\r\n\r\n  if (document.readyState === 'loading') {\r\n    document.addEventListener('DOMContentLoaded', init);\r\n  } else {\r\n    init();\r\n  }\r\n})();\r\n"
