ost\" style=\"width:100%;height:100%;\"></div>\n        </div>\n\n\n        <!-- Script to toggle the chat -->\n        <script>\n            (function() {\n                // Replace CHAT_URL below with your bot's URL. This can be obtained by publishing your bot to the Custom website channel in Copilot Studio and copying the URL from the embed code\n                // Using IIFE to avoid redeclaration if footer is included multiple times\n                if (window.chatBotInitialized) {\n                    return; // Already initialized\n                }\n                window.chatBotInitialized = true;\n\n                const CHAT_URL = \"https://gcc.powerva.microsoft.us/environments/e7cab1be-b6dd-e9ce-9db4-bbda432688bd/bots/cr72b_askAbby/webchat?__version__=2\";\n                let chatInitialized = false;\n\n                // Wait for DOM to be ready\n                function initChatBot() {\n                    const chatButton = document.getElementById('chatButton');\n                    const chatModal = document.getElementById('chatModal');\n                    const chatClose = document.getElementById('chatClose');\n                    const chatFrameHost = document.getElementById('chatFrameHost');\n\n                    if (!chatButton || !chatModal || !chatClose || !chatFrameHost) {\n                        return; // Elements don't exist yet\n                    }\n\n                    chatButton.addEventListener('click', function () {\n                        // Copilot Iframe\n                        if (!chatInitialized) {\n                            const iframe = document.createElement('iframe');\n                            iframe.width = \"100%\";\n                            iframe.height = \"100%\";\n                            iframe.frameBorder = \"0\";\n                            iframe.style.border = \"none\";\n                            iframe.src = CHAT_URL; // load only now\n                            chatFrameHost.appendChild(iframe);\n                            chatInitialized = true;\n                        }\n                        chatModal.style.display = 'block';\n                    });\n\n                    chatClose.addEventListener('click', function () {\n                        chatModal.style.display = 'none';\n                    });\n                }\n\n                // Initialize when DOM is ready\n                if (document.readyState === 'loading') {\n                    document.addEventListener('DOMContentLoaded', initChatBot);\n                } else {\n                    // DOM is already ready\n                    initChatBot();\n                }\n            })();\n        </script>\n\n    </footer>\n\n    </div>\n\n\n    <!-- G-Translate Code -->\n    <div class=\"gtranslate_wrapper gt_container--hich1m\"><div class=\"gt_switcher_wrapper\" style=\"position:fixed;top:0;right:8%;z-index:999999;\"><!-- GTranslate: https://gtranslate.com --><div id=\"google_translate_element2\"></div><div class=\"gt_switcher notranslate\"><div class=\"gt_selected\"><a href=\"#\"><img src=\"../_external/cdn.gtranslate.net/flags/svg/en-us.svg\" height=\"24\" width=\"24\" alt=\"en\"> English</a></div><div class=\"gt_option\"><a href=\"#\" title=\"English\" class=\"nturl gt_current\" data-gt-lang=\"en\"><img width=\"24\" height=\"24\" alt=\"en\" data-gt-lazy-src=\"https://cdn.gtranslate.net/flags/svg/en-us.svg\"> English</a><a href=\"#\" title=\"Spanish\" class=\"nturl\" data-gt-lang=\"es\"><img width=\"24\" height=\"24\" alt=\"es\" data-gt-lazy-src=\"https://cdn.gtranslate.net/flags/svg/es-mx.svg\"> Spanish</a><a href=\"#\" title=\"Haitian Creole\" class=\"nturl\" data-gt-lang=\"ht\"><img width=\"24\" height=\"24\" alt=\"ht\" data-gt-lazy-src=\"https://cdn.gtranslate.net/flags/svg/ht.svg\"> Haitian Creole</a></div></div></div></div>\n    <script>window.gtranslateSettings = {\"default_language\":\"en\",\"detect_browser_language\":true,\"languages\":[\"en\",\"es\",\"ht\"],\"wrap