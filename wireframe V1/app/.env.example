# Ask Sam — server-side only (never prefix with VITE_)
#
# Preferred (Scriptorium / Infisical): inject OPENAI_API_KEY without a local .env:
#   npm run dev:sam
# Requires Infisical CLI login against DecisionPro project decision-pro-s-ly6
# (secret path /application/openai → OPENAI_API_KEY).
#
# Offline / fallback: copy this file to .env and set one provider key locally.
# .env is gitignored — never commit secret values.

# Optional force: anthropic | openai | cursor
# ASK_SAM_PROVIDER=openai

# --- OpenAI (DecisionPro Infisical source of truth) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-sol
# ASK_SAM_MODEL=gpt-5.6-sol

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Cursor SDK (heavier; needs optional package) ---
# CURSOR_API_KEY=...
# CURSOR_MODEL=composer-2.5
# Then: npm install @cursor/sdk --save-optional

# Optional live BW Postgres for Ask Sam load-history digests (read-only).
# When unset, summarize_load_history uses export provenance only.
# DECISIONPRO_BW_DATABASE_URL=postgres://decisionpro:decisionpro_poc_local@127.0.0.1:5042/xenodroid_bw

# --- GitHub Pages demo client (build-time only; not a secret) ---
# VITE_ASK_SAM_API_BASE=https://<ask-sam-vercel-host>
# ASK_SAM_CORS_ORIGINS=https://demo.decisionpro.io,https://kg-modus-novus.github.io,http://localhost:5040

# OpenAI Responses hosted web search (default on for gpt-5.x)
# ASK_SAM_WEB_SEARCH=true
